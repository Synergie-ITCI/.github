#!/usr/bin/env python3
"""Run the active central PR-QA release as a local promotion preflight."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
import tarfile
import tempfile
from collections import Counter
from pathlib import Path


PIN_RE = re.compile(r'(?m)^\s*PR_QA_FRAMEWORK_RELEASE:\s*["\']?([^"\'\s]+)["\']?\s*$')
RC_RE = re.compile(r"^pr-qa-v1-rc([1-9][0-9]*)$")
CENTRAL_ORIGIN = "https://github.com/Synergie-ITCI/.github.git"
RESOLVED_RELEASE_RE = re.compile(r"Resolved active release (pr-qa-v1-rc[1-9][0-9]*) at [0-9a-f]{40}")


def run(cmd: list[str], cwd: Path, **kwargs: object) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, **kwargs)


def git(cmd: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    return run(["git", *cmd], cwd)


def repo_root() -> Path | None:
    proc = run(["git", "rev-parse", "--show-toplevel"], Path.cwd())
    if proc.returncode != 0:
        return None
    return Path(proc.stdout.strip())


def active_release(root: Path) -> str | None:
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode == 0 and origin.stdout.strip() == CENTRAL_ORIGIN:
        resolved = run([sys.executable, str(root / "pr-qa" / "release_pin.py"), "--resolve-active"], root)
        if resolved.returncode != 0:
            return None
        match = RESOLVED_RELEASE_RE.fullmatch(resolved.stdout.strip())
        return match.group(1) if match else None

    workflow = root / ".github" / "workflows" / "pr-qa.yml"
    if workflow.exists():
        match = PIN_RE.search(workflow.read_text(encoding="utf-8"))
        if match:
            return match.group(1)
    manifest = root / "policy" / "framework-releases.json"
    if not manifest.exists():
        return None
    try:
        releases = json.loads(manifest.read_text(encoding="utf-8")).get("releases", {})
    except json.JSONDecodeError:
        return None
    candidates = []
    for release in releases:
        match = RC_RE.fullmatch(str(release))
        if match:
            candidates.append((int(match.group(1)), str(release)))
    return max(candidates)[1] if candidates else None


def resolve_origin_base(root: Path, base: str) -> str | None:
    if base.startswith("-"):
        return None
    if git(["check-ref-format", "--branch", base], root).returncode != 0:
        return None
    ref = f"refs/remotes/origin/{base}^{{commit}}"
    proc = git(["rev-parse", "--verify", ref], root)
    return proc.stdout.strip() if proc.returncode == 0 else None


def worktree_state(root: Path) -> str:
    proc = git(["status", "--porcelain"], root)
    if proc.returncode != 0:
        return "DIRTY"
    return "DIRTY" if proc.stdout.strip() else "CLEAN"


def extract_release(root: Path, release: str, dest: Path) -> bool:
    archive = subprocess.run(
        ["git", "archive", "--format=tar", release],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if archive.returncode != 0:
        return False
    with tarfile.open(fileobj=__import__("io").BytesIO(archive.stdout), mode="r:") as tar:
        tar.extractall(dest)
    return True


def verify_central_lineage(root: Path, release: str, candidate: str) -> list[str]:
    """Require every first-parent change since the active tag to be a checked PR merge."""
    def checked_git(*args: str) -> str:
        result = git(list(args), root)
        if result.returncode:
            raise ValueError(f"lineage git query failed: {' '.join(args)}")
        return result.stdout.strip()

    def checked_api(path: str) -> object:
        result = run(["gh", "api", path], root)
        if result.returncode:
            raise ValueError(f"lineage GitHub evidence unavailable: {path}")
        return json.loads(result.stdout)

    remote = checked_api("repos/Synergie-ITCI/.github/git/ref/heads/main")
    if remote["object"]["sha"] != candidate or checked_git("rev-parse", "HEAD") != candidate:
        raise ValueError("candidate is not the exact current protected main commit")
    if checked_git("merge-base", release, candidate) != checked_git("rev-parse", f"{release}^{{commit}}"):
        raise ValueError("active release is not an ancestor of the candidate")
    rules = checked_api("repos/Synergie-ITCI/.github/rules/branches/main")
    required = {"pr-qa / Pull Request Quality Assurance", "Architecture Governance"}
    if not any(item.get("type") == "pull_request" for item in rules):
        raise ValueError("protected main no longer requires pull requests")
    contexts = {check["context"] for item in rules if item.get("type") == "required_status_checks"
                for check in (item.get("parameters") or {}).get("required_status_checks", [])}
    if "pr-qa / Pull Request Quality Assurance" not in contexts:
        raise ValueError("protected main no longer requires central PR-QA")
    commits = checked_git("rev-list", "--reverse", "--first-parent", f"{release}..{candidate}").splitlines()
    if not commits:
        raise ValueError("candidate contains no source changes after the active release")
    previous = checked_git("rev-parse", f"{release}^{{commit}}")
    for commit in commits:
        parents = checked_git("rev-list", "--parents", "-n", "1", commit).split()
        if parents[0] != commit or len(parents) not in (2, 3) or parents[1] != previous:
            raise ValueError(f"unexpected merge or direct push: {commit}")
        associated = checked_api(f"repos/Synergie-ITCI/.github/commits/{commit}/pulls")
        matches = [pr for pr in associated if pr.get("merge_commit_sha") == commit
                   and pr.get("merged_at") and pr.get("base", {}).get("ref") == "main"]
        if len(matches) != 1:
            raise ValueError(f"commit has no unique approved merged PR: {commit}")
        pr = matches[0]
        head = pr.get("head", {}).get("sha")
        if not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
            raise ValueError(f"PR head identity unavailable: {commit}")
        if len(parents) == 2:
            if checked_git("rev-parse", f"{head}^{{tree}}") != checked_git("rev-parse", f"{commit}^{{tree}}"):
                raise ValueError(f"squash content differs from reviewed PR head: {commit}")
        elif parents[2] != head:
            raise ValueError(f"merge parent differs from reviewed PR head: {commit}")
        checks = checked_api(f"repos/Synergie-ITCI/.github/commits/{head}/check-runs?per_page=100")
        if checks.get("total_count", 0) > 100:
            raise ValueError(f"check evidence is truncated: {commit}")
        latest: dict[str, dict] = {}
        for check in checks.get("check_runs", []):
            if check.get("head_sha") != head or check.get("app", {}).get("slug") != "github-actions":
                continue
            if not isinstance(check.get("id"), int) or not isinstance(check.get("name"), str):
                raise ValueError(f"check identity unavailable for PR #{pr['number']}: {commit}")
            name = check["name"]
            if name not in latest or check["id"] > latest[name]["id"]:
                latest[name] = check
        if any(latest.get(name, {}).get("status") != "completed"
               or latest.get(name, {}).get("conclusion") != "success" for name in required):
            raise ValueError(f"required exact-head checks missing for PR #{pr['number']}: {commit}")
        previous = commit
    return commits


def reviewed_rc201_disposition(root: Path, report_path: Path, base: str, release: str) -> bool:
    """Classify only the reviewed rc200 findings for the protected rc201 promotion."""
    if base != "main" or release != "pr-qa-v1-rc200":
        return False
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode or origin.stdout.strip() != CENTRAL_ORIGIN:
        return False
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
        policy = json.loads((root / "policy" / "pr-qa-policy.json").read_text(encoding="utf-8"))
        disposition = policy["release_preflight_dispositions"]["pr-qa-v1-rc201"]
        merge = disposition["approved_merge"]
        expected = {(item["path"], item["label"], item["line_sha256"]) for item in disposition["synthetic_fixture_findings"]}
        if len(expected) != len(disposition["synthetic_fixture_findings"]):
            return False
        failures = [item for item in report["results"] if item.get("blocking") and item.get("status") == "FAIL"]
        if len(failures) != 2 or {item.get("gate") for item in failures} != {"Repository Hygiene", "Secrets"}:
            return False
        hygiene = next(item for item in failures if item["gate"] == "Repository Hygiene")
        secrets = next(item for item in failures if item["gate"] == "Secrets")
        if hygiene.get("message") != "Accidental merge commits detected." or hygiene.get("details") != [merge["sha"]]:
            return False
        actual = set()
        for detail in secrets["details"]:
            match = re.fullmatch(r"([^:]+): (.+)\. line_sha256=([0-9a-f]{64})", detail)
            if not match:
                return False
            path, label, fingerprint = match.groups()
            if path != "tests/test_pr_qa_regressions.py":
                return False
            source = root / path
            if not source.is_file() or source.is_symlink():
                return False
            if not any(hashlib.sha256(line.strip().encode("utf-8")).hexdigest() == fingerprint
                       for line in source.read_text(encoding="utf-8").splitlines()):
                return False
            actual.add((path, label, fingerprint))
        if len(secrets["details"]) != len(expected) or actual != expected:
            return False
        parents = git(["rev-list", "--parents", "-n", "1", merge["sha"]], root)
        if parents.returncode or parents.stdout.split() != [merge["sha"], merge["base_sha"], merge["head_sha"]]:
            return False
        first_parent = git(["rev-list", "--first-parent", "--merges", f"{merge['base_sha']}..HEAD"], root)
        if first_parent.returncode or first_parent.stdout.split() != [merge["sha"]]:
            return False
        candidate_tree = git(["rev-parse", f"{merge['sha']}^{{tree}}"], root)
        reviewed_tree = git(["rev-parse", f"{merge['head_sha']}^{{tree}}"], root)
        if candidate_tree.returncode or reviewed_tree.returncode or candidate_tree.stdout != reviewed_tree.stdout:
            return False
        pr = run(["gh", "api", f"repos/Synergie-ITCI/.github/pulls/{merge['pr']}"], root)
        if pr.returncode:
            return False
        metadata = json.loads(pr.stdout)
        return bool(metadata.get("merged_at") and metadata.get("merge_commit_sha") == merge["sha"]
                    and metadata.get("head", {}).get("sha") == merge["head_sha"]
                    and metadata.get("base", {}).get("ref") == "main")
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return False


def reviewed_rc202_disposition(root: Path, report_path: Path, base: str, release: str) -> bool:
    """Accept only rc201-inherited findings for the exact reviewed rc202 PR merge."""
    if base != "main" or release != "pr-qa-v1-rc201":
        return False
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode or origin.stdout.strip() != CENTRAL_ORIGIN:
        return False
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
        policy = json.loads((root / "policy" / "pr-qa-policy.json").read_text(encoding="utf-8"))
        disposition = policy["release_preflight_dispositions"]["pr-qa-v1-rc202"]
        if disposition["predecessor_release"] != release or disposition["approved_correction_pr"] != 384:
            return False
        merge = disposition["approved_merge"]
        failures = [item for item in report["results"] if item.get("blocking") and item.get("status") == "FAIL"]
        if len(failures) != 3 or {item.get("gate") for item in failures} != {
            "Repository Hygiene", "Secrets", "Persistent Data Safety"
        }:
            return False
        by_gate = {item["gate"]: item for item in failures}
        if (by_gate["Repository Hygiene"].get("message") != "Accidental merge commits detected."
                or by_gate["Repository Hygiene"].get("details") != [merge["sha"]]):
            return False
        expected_literals = disposition["classifier_literal_finding_sha256"]
        if (len(expected_literals) != 6
                or Counter(hashlib.sha256(detail.encode()).hexdigest()
                           for detail in by_gate["Persistent Data Safety"].get("details", []))
                != Counter(expected_literals)):
            return False

        expected_fixtures = disposition["synthetic_fixture_findings"]
        expected = {(item["path"], item["label"], item["line_sha256"]) for item in expected_fixtures}
        if len(expected) != len(expected_fixtures) or len(expected) != 6:
            return False
        actual = set()
        for detail in by_gate["Secrets"].get("details", []):
            match = re.fullmatch(r"([^:]+): (.+)\. line_sha256=([0-9a-f]{64})", detail)
            if not match:
                return False
            path, label, fingerprint = match.groups()
            if path != "tests/test_pr_qa_regressions.py":
                return False
            source = root / path
            inherited = git(["show", f"{release}:{path}"], root)
            if (not source.is_file() or source.is_symlink() or inherited.returncode
                    or not any(hashlib.sha256(line.strip().encode()).hexdigest() == fingerprint
                               for line in source.read_text(encoding="utf-8").splitlines())
                    or not any(hashlib.sha256(line.strip().encode()).hexdigest() == fingerprint
                               for line in inherited.stdout.splitlines())):
                return False
            actual.add((path, label, fingerprint))
        if len(by_gate["Secrets"].get("details", [])) != len(expected) or actual != expected:
            return False

        parents = git(["rev-list", "--parents", "-n", "1", merge["sha"]], root)
        if parents.returncode or parents.stdout.split() != [merge["sha"], merge["base_sha"], merge["head_sha"]]:
            return False
        if git(["merge-base", "--is-ancestor", merge["sha"], release], root).returncode:
            return False
        first_parent = git(["rev-list", "--first-parent", "--merges", f"{merge['base_sha']}..HEAD"], root)
        if first_parent.returncode or first_parent.stdout.split() != [merge["sha"]]:
            return False
        head = git(["rev-parse", "HEAD"], root)
        main = git(["rev-parse", "refs/remotes/origin/main"], root)
        if head.returncode or main.returncode or head.stdout != main.stdout:
            return False
        pr = run(["gh", "api", "repos/Synergie-ITCI/.github/pulls/384"], root)
        if pr.returncode:
            return False
        metadata = json.loads(pr.stdout)
        if (not metadata.get("merged_at") or metadata.get("merge_commit_sha") != head.stdout.strip()
                or metadata.get("base", {}).get("ref") != "main"):
            return False
        reviewed_tree = git(["rev-parse", f"{metadata['head']['sha']}^{{tree}}"], root)
        candidate_tree = git(["rev-parse", "HEAD^{tree}"], root)
        return bool(not reviewed_tree.returncode and not candidate_tree.returncode
                    and reviewed_tree.stdout == candidate_tree.stdout)
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return False


def reviewed_rc203_disposition(root: Path, report_path: Path, base: str, release: str) -> bool:
    """Accept only rc202-inherited synthetic fixtures after reviewed protected squash merges."""
    if base != "main" or release != "pr-qa-v1-rc202":
        return False
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode or origin.stdout.strip() != CENTRAL_ORIGIN:
        return False
    try:
        policy = json.loads((root / "policy" / "pr-qa-policy.json").read_text(encoding="utf-8"))
        disposition = policy["release_preflight_dispositions"]["pr-qa-v1-rc203"]
        if (disposition["predecessor_release"] != release
                or disposition["predecessor_correction_pr"] != 385
                or disposition["approved_correction_pr"] != 386):
            return False
        report = json.loads(report_path.read_text(encoding="utf-8"))
        failures = [item for item in report["results"] if item.get("blocking") and item.get("status") == "FAIL"]
        if len(failures) != 1 or failures[0].get("gate") != "Secrets":
            return False
        expected = {(item["path"], item["label"], item["line_sha256"])
                    for item in disposition["synthetic_fixture_findings"]}
        if len(expected) != len(disposition["synthetic_fixture_findings"]) or len(expected) != 26:
            return False
        details = failures[0].get("details", [])
        if len(details) != len(expected):
            return False
        inherited = git(["show", f"{release}:tests/test_pr_qa_regressions.py"], root)
        source = root / "tests/test_pr_qa_regressions.py"
        if inherited.returncode or not source.is_file() or source.is_symlink():
            return False
        current_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                          for line in source.read_text(encoding="utf-8").splitlines()}
        inherited_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                            for line in inherited.stdout.splitlines()}
        actual = set()
        for detail in details:
            match = re.fullmatch(r"([^:]+): (.+)\. line_sha256=([0-9a-f]{64})", detail)
            if not match:
                return False
            path, label, fingerprint = match.groups()
            if path != "tests/test_pr_qa_regressions.py" or fingerprint not in current_hashes or fingerprint not in inherited_hashes:
                return False
            actual.add((path, label, fingerprint))
        if actual != expected:
            return False

        head = git(["rev-parse", "HEAD"], root)
        main = git(["rev-parse", "refs/remotes/origin/main"], root)
        count = git(["rev-list", "--count", f"{release}..HEAD"], root)
        merges = git(["rev-list", "--first-parent", "--merges", f"{release}..HEAD"], root)
        if (head.returncode or main.returncode or head.stdout != main.stdout
                or count.returncode or count.stdout.strip() != "2"
                or merges.returncode or merges.stdout.strip()):
            return False
        prior_pr = run(["gh", "api", "repos/Synergie-ITCI/.github/pulls/385"], root)
        pr = run(["gh", "api", "repos/Synergie-ITCI/.github/pulls/386"], root)
        if prior_pr.returncode or pr.returncode:
            return False
        prior_metadata = json.loads(prior_pr.stdout)
        metadata = json.loads(pr.stdout)
        parent = git(["rev-parse", "HEAD^"], root)
        if (not prior_metadata.get("merged_at")
                or prior_metadata.get("base", {}).get("ref") != "main"
                or parent.returncode
                or prior_metadata.get("merge_commit_sha") != parent.stdout.strip()):
            return False
        if (not metadata.get("merged_at") or metadata.get("merge_commit_sha") != head.stdout.strip()
                or metadata.get("base", {}).get("ref") != "main"):
            return False
        reviewed_tree = git(["rev-parse", f"{metadata['head']['sha']}^{{tree}}"], root)
        candidate_tree = git(["rev-parse", "HEAD^{tree}"], root)
        return bool(not reviewed_tree.returncode and not candidate_tree.returncode
                    and reviewed_tree.stdout == candidate_tree.stdout)
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return False


def reviewed_rc204_disposition(root: Path, report_path: Path, base: str, release: str) -> bool:
    """Accept only unchanged rc203 test fixtures after the reviewed PR #387 squash."""
    if base != "main" or release != "pr-qa-v1-rc203":
        return False
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode or origin.stdout.strip() != CENTRAL_ORIGIN:
        return False
    try:
        policy = json.loads((root / "policy" / "pr-qa-policy.json").read_text(encoding="utf-8"))
        disposition = policy["release_preflight_dispositions"]["pr-qa-v1-rc204"]
        if disposition["predecessor_release"] != release or disposition["approved_correction_pr"] != 387:
            return False
        report = json.loads(report_path.read_text(encoding="utf-8"))
        failures = [item for item in report["results"] if item.get("blocking") and item.get("status") == "FAIL"]
        if len(failures) != 1 or failures[0].get("gate") != "Secrets":
            return False
        expected = {(item["path"], item["label"], item["line_sha256"])
                    for item in disposition["synthetic_fixture_findings"]}
        details = failures[0].get("details", [])
        if len(expected) != 26 or len(expected) != len(disposition["synthetic_fixture_findings"]) or len(details) != len(expected):
            return False
        inherited = git(["show", f"{release}:tests/test_pr_qa_regressions.py"], root)
        source = root / "tests/test_pr_qa_regressions.py"
        if inherited.returncode or not source.is_file() or source.is_symlink():
            return False
        current_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                          for line in source.read_text(encoding="utf-8").splitlines()}
        inherited_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                            for line in inherited.stdout.splitlines()}
        actual = set()
        for detail in details:
            match = re.fullmatch(r"([^:]+): (.+)\. line_sha256=([0-9a-f]{64})", detail)
            if not match:
                return False
            path, label, fingerprint = match.groups()
            if path != "tests/test_pr_qa_regressions.py" or fingerprint not in current_hashes or fingerprint not in inherited_hashes:
                return False
            actual.add((path, label, fingerprint))
        if actual != expected:
            return False
        head = git(["rev-parse", "HEAD"], root)
        main = git(["rev-parse", "refs/remotes/origin/main"], root)
        count = git(["rev-list", "--count", f"{release}..HEAD"], root)
        merges = git(["rev-list", "--first-parent", "--merges", f"{release}..HEAD"], root)
        if (head.returncode or main.returncode or head.stdout != main.stdout
                or count.returncode or count.stdout.strip() != "1"
                or merges.returncode or merges.stdout.strip()):
            return False
        pr = run(["gh", "api", "repos/Synergie-ITCI/.github/pulls/387"], root)
        if pr.returncode:
            return False
        metadata = json.loads(pr.stdout)
        if (not metadata.get("merged_at") or metadata.get("merge_commit_sha") != head.stdout.strip()
                or metadata.get("base", {}).get("ref") != "main"):
            return False
        reviewed_tree = git(["rev-parse", f"{metadata['head']['sha']}^{{tree}}"], root)
        candidate_tree = git(["rev-parse", "HEAD^{tree}"], root)
        return bool(not reviewed_tree.returncode and not candidate_tree.returncode
                    and reviewed_tree.stdout == candidate_tree.stdout)
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return False

def reviewed_inherited_fixture_disposition(root: Path, report_path: Path, base: str, release: str) -> bool:
    """Accept only exact, previously reviewed fixture lines inherited from the active tag."""
    if base != "main" or not RC_RE.fullmatch(release):
        return False
    origin = git(["remote", "get-url", "origin"], root)
    if origin.returncode or origin.stdout.strip() != CENTRAL_ORIGIN:
        return False
    try:
        policy = json.loads((root / "policy" / "pr-qa-policy.json").read_text(encoding="utf-8"))
        disposition = policy["release_preflight_dispositions"]["inherited_synthetic_fixtures"]
        report = json.loads(report_path.read_text(encoding="utf-8"))
        failures = [item for item in report["results"] if item.get("blocking") and item.get("status") == "FAIL"]
        if len(failures) != 1 or failures[0].get("gate") != "Secrets":
            return False
        expected = {(item["path"], item["label"], item["line_sha256"])
                    for item in disposition["synthetic_fixture_findings"]}
        details = failures[0].get("details", [])
        if not expected or len(expected) != len(disposition["synthetic_fixture_findings"]) or not details:
            return False
        inherited = git(["show", f"{release}:tests/test_pr_qa_regressions.py"], root)
        source = root / "tests/test_pr_qa_regressions.py"
        if inherited.returncode or not source.is_file() or source.is_symlink():
            return False
        current_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                          for line in source.read_text(encoding="utf-8").splitlines()}
        inherited_hashes = {hashlib.sha256(line.strip().encode()).hexdigest()
                            for line in inherited.stdout.splitlines()}
        actual = set()
        for detail in details:
            match = re.fullmatch(r"([^:]+): (.+)\. line_sha256=([0-9a-f]{64})", detail)
            if not match:
                return False
            path, label, fingerprint = match.groups()
            if path != "tests/test_pr_qa_regressions.py" or fingerprint not in current_hashes or fingerprint not in inherited_hashes:
                return False
            actual.add((path, label, fingerprint))
        if not actual or not actual <= expected:
            return False
        return True
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return False


def run_pr_qa(root: Path, framework: Path, base: str, base_sha: str, release: str = "") -> bool:
    head_sha = git(["rev-parse", "HEAD"], root).stdout.strip()
    head_ref = git(["branch", "--show-current"], root).stdout.strip() or "HEAD"
    with tempfile.TemporaryDirectory(prefix="release-preflight-qa-") as tmp:
        tmp_path = Path(tmp)
        event = tmp_path / "event.json"
        event.write_text(
            json.dumps(
                {
                    "release_preflight": {
                        "technical_validation_only": True,
                        "base_sha": base_sha,
                        "head_sha": head_sha,
                    },
                }
            ),
            encoding="utf-8",
        )
        report_path = tmp_path / "pr-quality-report.json"
        proc = subprocess.run(
            [
                sys.executable,
                str(framework / "pr-qa" / "pr_qa.py"),
                "--repo",
                str(root),
                "--event-path",
                str(event),
                "--base-ref",
                base,
                "--head-ref",
                head_ref,
                "--out",
                str(tmp_path / "pr-quality-report.md"),
                "--json-out",
                str(report_path),
            ],
            cwd=root,
        )
        if proc.returncode == 0:
            return True
        if reviewed_rc201_disposition(root, report_path, base, release):
            print("Active PR-QA findings matched the reviewed rc201 merge and exact synthetic fixture fingerprints.")
            return True
        if reviewed_rc202_disposition(root, report_path, base, release):
            print("Active PR-QA findings matched the exact reviewed rc202 correction and inherited fingerprints.")
            return True
        if reviewed_rc203_disposition(root, report_path, base, release):
            print("Active PR-QA findings matched the exact reviewed rc203 correction and inherited fixture fingerprints.")
            return True
        if reviewed_rc204_disposition(root, report_path, base, release):
            print("Active PR-QA findings matched the exact reviewed rc204 correction and inherited fixture fingerprints.")
            return True
        if reviewed_inherited_fixture_disposition(root, report_path, base, release):
            print("Active PR-QA findings matched exact reviewed fixture fingerprints inherited from the active release.")
            return True
        return False


def run_consumer_compatibility(root: Path) -> bool:
    script = root / "scripts" / "consumer-compatibility-preflight"
    if not script.exists():
        return False
    proc = subprocess.run([sys.executable, str(script), "--repo", str(root)], cwd=root)
    return proc.returncode == 0


def print_report(release: str, base: str, dirty: str, qa: str, compatibility: str, blockers: list[str]) -> None:
    ready = "NO" if blockers else "YES"
    staging = base == "staging"
    print("DEVELOPER STAGING READINESS" if staging else "DEVELOPER RELEASE READINESS")
    print()
    print(f"ACTIVE_PR_QA_RELEASE: {release}")
    print(f"BASE: {base}")
    print(f"WORKTREE: {dirty}")
    print(f"CENTRAL_PR_QA: {qa}")
    print(f"CONSUMER_COMPATIBILITY: {compatibility}")
    print()
    if staging:
        print(f"DEVELOPER_HANDOFF_READY: {ready}")
    else:
        print(f"READY_FOR_PROMOTION: {ready}")
    print()
    print("BLOCKERS:")
    if blockers:
        for blocker in blockers:
            print(f"- {blocker}")
    else:
        print("- none")


def main() -> int:
    parser = argparse.ArgumentParser(description="Run central PR-QA before release promotion.")
    parser.add_argument("--base", default="development", help="promotion base branch")
    parser.add_argument("--verified-release", help="release already resolved in this publication operation")
    parser.add_argument("--verified-commit", help="exact commit of the verified release")
    args = parser.parse_args()
    if bool(args.verified_release) != bool(args.verified_commit):
        parser.error("--verified-release and --verified-commit must be provided together")

    root = repo_root()
    blockers: list[str] = []
    release = ""
    qa = "FAIL"
    compatibility = "FAIL"
    dirty = "DIRTY"

    if root is None:
        print_report(release, args.base, dirty, qa, compatibility, ["not inside a git repository"])
        return 1

    if args.verified_release and args.verified_commit:
        try:
            sys.path.insert(0, str(root / "pr-qa"))
            from release_pin import verify_bound_release  # pylint: disable=import-outside-toplevel
            manifest = json.loads((root / "policy/framework-releases.json").read_text())
            verify_bound_release(args.verified_release, args.verified_commit, manifest)
            local_commit = git(["rev-parse", "--verify", f"{args.verified_release}^{{commit}}"], root)
            if local_commit.returncode or local_commit.stdout.strip() != args.verified_commit:
                raise ValueError("Local immutable tag differs from verified release commit")
            release = args.verified_release
        except (ImportError, OSError, ValueError, json.JSONDecodeError) as exc:
            blockers.append(f"verified release identity unavailable: {exc}")
    else:
        release = active_release(root) or ""
    if not release:
        blockers.append("active PR-QA release pin could not be derived")

    base_sha = resolve_origin_base(root, args.base)
    if not base_sha:
        blockers.append(f"base '{args.base}' could not be resolved as origin/{args.base}")

    dirty = worktree_state(root)
    if dirty == "DIRTY":
        blockers.append("working tree has uncommitted changes")

    origin = git(["remote", "get-url", "origin"], root)
    if not blockers and args.base == "main" and origin.returncode == 0 and origin.stdout.strip() == CENTRAL_ORIGIN:
        candidate = git(["rev-parse", "HEAD"], root)
        try:
            commits = verify_central_lineage(root, release, candidate.stdout.strip())
            print(f"Verified {len(commits)} protected PR merge(s) since {release}.")
        except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
            blockers.append(f"central source lineage: {exc}")

    if not blockers and release and base_sha:
        with tempfile.TemporaryDirectory(prefix="release-preflight-framework-") as tmp:
            framework = Path(tmp)
            if extract_release(root, release, framework):
                qa_passed = run_pr_qa(root, framework, args.base, base_sha, release)
                qa = "PASS" if qa_passed else "FAIL"
                if not qa_passed:
                    blockers.append("central PR-QA failed")
            else:
                blockers.append(f"active PR-QA release '{release}' could not be resolved")

    if root is not None and dirty == "CLEAN":
        compatibility_passed = run_consumer_compatibility(root)
        compatibility = "PASS" if compatibility_passed else "FAIL"
        if not compatibility_passed:
            blockers.append("representative consumer compatibility preflight failed")

    print_report(release, args.base, dirty, qa, compatibility, blockers)
    return 0 if not blockers else 1


if __name__ == "__main__":
    raise SystemExit(main())
