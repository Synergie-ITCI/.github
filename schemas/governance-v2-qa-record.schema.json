{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synergie Governance V2 Independent QA Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "candidate_id", "staging_sha", "tree_sha", "content_digest", "verdict", "reviewer", "timestamp", "evidence_reference"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "staging_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "reviewer": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "evidence_reference": {"type": "string", "minLength": 1}
  }
}
