{
  "schema_version": 1,
  "version": "governance-v2-pilot-v2.1.0",
  "mode": "authoritative-pilot",
  "pilot_repositories": {
    "Synergie-ITCI/programme-management-platform": {
      "independent_qa_reviewers": ["SaurabhVermaIN"],
      "production_approvers": ["SaurabhVermaIN"]
    },
    "Synergie-ITCI/telemedicine-backend": {
      "independent_qa_reviewers": ["SaurabhVermaIN"],
      "production_approvers": ["SaurabhVermaIN"]
    }
  },
  "repository_enrollment": {
    "authorized_actors": ["SaurabhVermaIN"],
    "max_hours": 72,
    "allowed_path_patterns": [
      ".github/synergie-governance.yml",
      ".github/synergie-recovery.yml",
      ".github/governance-v2-policy.json",
      ".github/scripts/governance_v2_*.py",
      ".github/workflows/architecture-governance.yml",
      ".github/workflows/synergie-v2-shadow-governance.yml",
      ".github/workflows/deploy.yml",
      ".github/workflows/governance-v2-*.yml",
      ".github/workflows/*governance*v2*.yml",
      ".github/workflows/*independent*qa*.yml",
      ".github/workflows/*qa-record*.yml",
      ".github/workflows/*release*.yml",
      ".github/workflows/pr-qa.yml",
      ".github/workflows/uat-operations.yml",
      ".github/CODEOWNERS",
      "CODEOWNERS",
      "docs/CODEOWNERS"
    ],
    "required_evidence": [
      "existing_ci",
      "staging",
      "architecture_governance",
      "independent_qa"
    ]
  },
  "protected_path_patterns": [
    ".github/**",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    "deploy/**"
  ],
  "migration_path_patterns": [
    "**/alembic/**",
    "**/migrations/**",
    "**/*.sql"
  ],
  "dependency_path_patterns": [
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/poetry.lock",
    "**/Pipfile.lock",
    "**/requirements*.txt",
    "**/composer.lock",
    "**/go.sum",
    "**/Cargo.lock"
  ],
  "workflow_path_patterns": [".github/workflows/**"],
  "authorization_max_hours": 72
}
