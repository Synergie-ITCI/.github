{
  "version": 1,
  "policy_id": "synergie-pr-qa-enterprise-v1",
  "mandatory_gates": [
    "baseline_alignment",
    "repository_hygiene",
    "formatting",
    "lint",
    "build",
    "tests",
    "git_validation",
    "secrets",
    "dependencies",
    "licence",
    "deployment_safety",
    "database_safety",
    "documentation",
    "protected_resources",
    "review_policy",
    "risk",
    "evidence"
  ],
  "optional_gates": [
    "advisory_review"
  ],
  "emergency_override": {
    "authorized_actors": [
      "SaurabhVermaIN"
    ],
    "audit_artifact": "emergency-override-audit.json"
  },
  "governance": {
    "review_policy": {
      "owner_review_exception": {
        "github_login": "SaurabhVermaIN",
        "independent_human_review_required": false
      },
      "required_independent_approvals": 1,
      "require_independent_review_for_other_authors": true,
      "identity_source": "github_login",
      "automated_gates_remain_mandatory": true
    },
    "executive_release_authority": {
      "current_holder": "SaurabhVermaIN",
      "required_reviewers": [
        "SaurabhVermaIN"
      ],
      "developer_self_approval_allowed": false,
      "non_authority_approval_satisfies_protection": false,
      "native_required_review_count": 0,
      "review_policy_status_check_required": true,
      "require_last_push_approval": false,
      "administrator_bypass": {
        "eligible_actors": [
          "SaurabhVermaIN"
        ],
        "requires_completed_qa": true,
        "requires_reason": true,
        "preserve_qa_evidence": true
      }
    }
  },
  "minimum_thresholds": {
    "max_file_bytes": 5242880,
    "max_changed_files": 200,
    "max_additions": 5000,
    "risk_warning": 40,
    "risk_fail": 85
  },
  "one_time_baseline_alignment": {
    "enabled": true,
    "repository": "Synergie-ITCI/dhansamvaad-new.synergieinsights.in",
    "base_ref": "main",
    "head_ref": "staging",
    "expected_base_sha": "3e2404bb53874fa5e46f249eba55914193eeef1c",
    "expected_head_sha": "1919ba8edd6de50cccc9a2ed09f731ccbac28ed5",
    "expires_after": "2026-08-24T00:00:00Z",
    "minimum_changed_files": 300,
    "required_pr_body_marker": "ONE-TIME DHANSAMVAAD STAGING TO MAIN BASELINE AUTHORIZATION PR-15",
    "relaxations": [
      "diff_size",
      "changed_file_count"
    ]
  },
  "defaults": {
    "version": 1,
    "repository": {
      "profile": "application",
      "criticality": "medium",
      "protected_paths": [
        ".gitleaks.toml",
        ".github/**",
        "CODEOWNERS",
        "docs/CODEOWNERS",
        ".github/CODEOWNERS",
        "policy/**",
        "schemas/**",
        "deployment/**",
        "deploy/**",
        "infra/**",
        "terraform/**",
        "k8s/**",
        "kubernetes/**",
        "Dockerfile",
        "Dockerfile.*",
        "docker-compose*.yml",
        "docker-compose*.yaml",
        "nginx/**",
        "apache/**",
        "scripts/deploy*",
        ".env.example"
      ]
    },
    "gates": {},
    "thresholds": {
      "max_file_bytes": 5242880,
      "max_changed_files": 200,
      "max_additions": 5000,
      "risk_warning": 40,
      "risk_fail": 85
    },
    "branch_naming": {
      "allowed_patterns": [
        "^(feature|feat|fix|hotfix|release|chore|docs|test|refactor|security|codex)/[a-zA-Z0-9._/-]+$",
        "^(main|master|develop|development|staging)$"
      ]
    },
    "commit_messages": {
      "allowed_patterns": [
        "^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|security|release|promote|revert)(\\([^)]+\\))?: .+",
        "^Merge .+"
      ]
    },
    "evidence": {
      "required_fields": [
        "business purpose",
        "testing performed",
        "rollback strategy",
        "linked issue"
      ],
      "screenshots_required_for_ui_changes": true
    },
    "runtime": {
      "install_dependencies": true,
      "allow_network_installs": true,
      "fail_fast_on_secrets": true
    },
    "adapters": {}
  },
  "generated_path_components": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "coverage",
    ".next",
    ".gradle",
    "target",
    "Pods",
    "__pycache__"
  ],
  "generated_artifact_patterns": [
    "*.pyc",
    "*.pyo",
    "*.class",
    "*.o",
    "*.so",
    "*.dll",
    "*.dylib",
    "*.min.js.map",
    "storage/logs/**"
  ],
  "allowed_binary_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".pdf"
  ],
  "allowed_hidden_files": [
    ".github",
    ".gitleaks.toml",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".styleci.yml",
    ".dockerignore",
    ".env.example",
    ".env.sample",
    ".env.template"
  ],
  "stack_integrity_exceptions": {
    "react_native": {
      "hidden_text_files": [
        ".watchmanconfig",
        ".bundle/config",
        "ios/.xcode.env"
      ],
      "binary_bootstrap_files": [
        "android/gradle/wrapper/gradle-wrapper.jar",
        "android/app/debug.keystore"
      ],
      "line_ending_text_files": [
        "android/gradlew.bat"
      ],
      "max_gradle_wrapper_jar_bytes": 262144,
      "max_debug_keystore_bytes": 16384,
      "max_hidden_text_file_bytes": 8192
    }
  },
  "approved_governance_assets": [
    ".gitleaks.toml",
    ".github/**",
    ".gitignore",
