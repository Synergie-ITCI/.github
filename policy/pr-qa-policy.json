{
  "version": 1,
  "policy_id": "synergie-pr-qa-enterprise-v1",
  "mandatory_gates": [
    "baseline_alignment",
    "repository_hygiene",
    "formatting",
    "lint",
    "build",
    "tests",
    "git_validation",
    "secrets",
    "dependencies",
    "licence",
    "deployment_safety",
    "database_safety",
    "documentation",
    "protected_resources",
    "persistent_data_safety",
    "review_policy",
    "risk",
    "evidence"
  ],
  "optional_gates": [
    "advisory_review"
  ],
  "emergency_override": {
    "authorized_actors": [
      "SaurabhVermaIN"
    ],
    "audit_artifact": "emergency-override-audit.json"
  },
  "governance": {
    "review_policy": {
      "owner_review_exception": {
        "github_login": "SaurabhVermaIN",
        "independent_human_review_required": false
      },
      "required_independent_approvals": 1,
      "require_independent_review_for_other_authors": true,
      "identity_source": "github_login",
      "automated_gates_remain_mandatory": true
    },
    "executive_release_authority": {
      "current_holder": "SaurabhVermaIN",
      "required_reviewers": [
        "SaurabhVermaIN"
      ],
      "developer_self_approval_allowed": false,
      "non_authority_approval_satisfies_protection": false,
      "native_required_review_count": 0,
      "review_policy_status_check_required": true,
      "require_last_push_approval": false,
      "administrator_bypass": {
        "eligible_actors": [
          "SaurabhVermaIN"
        ],
        "requires_completed_qa": true,
        "requires_reason": true,
        "preserve_qa_evidence": true
      }
    },
    "migration_sql_reviewers": [
      {
        "login": "SaurabhVermaIN",
        "id": 52234089
      }
    ],
    "critical_infrastructure_paths": [
      {
        "repository": "Synergie-ITCI/programme-management-platform",
        "paths": [
          "infra/aws/**"
        ],
        "required_reviewers": [
          "SaurabhVermaIN"
        ],
        "required_controls": [
          "github-actions-oidc-only",
          "plan-apply-separation",
          "no-apply-from-pull-request",
          "environment-approval-before-apply"
        ],
        "risk": "critical"
      }
    ],
    "pr_consolidation_policy": {
      "default": "one_logical_objective_one_task_branch_one_pr_per_repository",
      "keep_pr_open_until_repository_scoped_objective_is_satisfied": true,
      "same_pr_updates": [
        "implementation",
        "tests",
        "fixtures",
        "documentation",
        "workflow_references",
        "review_fixes",
        "pr_qa_corrections"
      ],
      "pre_merge_inspection": [
        "downstream_callers",
        "releases",
        "migrations",
        "rollback",
        "cross_repository_dependencies"
      ],
      "current_head_revalidation_required": true,
      "earlier_pass_reuse": "allowed_only_when_relevant_inputs_have_not_changed",
      "branch_update_rules": {
        "update_task_branch_only_when_needed": true,
        "never_rewrite_protected_or_shared_branches": true,
        "force_with_lease_required": true,
        "plain_force_push_allowed": false
      },
      "separate_repositories_require_separate_prs": true,
      "sequential_pr_explanation_required": [
        "why_open_pr_cannot_be_reused",
        "exact_technical_or_governance_reason",
        "whether_separation_is_unavoidable",
        "expected_remaining_pr_count"
      ],
      "separate_pr_allowed_when": [
        "immutable_post_merge_metadata_must_exist_first",
        "work_belongs_to_another_repository",
        "independently_reviewable_or_deployable_stage_materially_reduces_risk",
        "newly_discovered_foundational_or_higher_risk_defect_requires_different_scrutiny_validation_or_rollback",
        "urgent_security_or_hotfix_must_remain_isolated",
        "governance_technically_requires_separation",
        "user_explicitly_authorizes_separation"
      ],
      "scope_guardrails": [
        "never_combine_unrelated_work",
        "never_force_higher_risk_change_into_oversized_pr_to_reduce_pr_count"
      ],
      "avoidable_fragmentation_event": {
        "record_when_reasonably_discoverable_corrective_pr_was_missed_before_merge_and_no_exception_applies": true,
        "required_fields": [
          "missed_check",
          "preventive_improvement"
        ],
        "assign_blame": false
      },
      "release_rule": {
        "complete_known_implementation_tests_documentation_and_release_reference_updates_before_merge": true,
        "prove_release_candidate_before_tagging_or_activation": true,
        "separate_activation_pr_allowed_only_when_immutable_tag_or_ruleset_metadata_cannot_exist_beforehand": true,
        "preserve_earlier_immutable_releases": true
      }
    }
  },
  "minimum_thresholds": {
    "max_file_bytes": 5242880,
    "max_changed_files": 200,
    "max_additions": 5000,
    "risk_warning": 40,
    "risk_fail": 85
  },
  "defaults": {
    "version": 1,
    "repository": {
      "profile": "application",
      "criticality": "medium",
      "protected_paths": [
        ".gitleaks.toml",
        ".github/**",
        "CODEOWNERS",
        "docs/CODEOWNERS",
        ".github/CODEOWNERS",
        "policy/**",
        "schemas/**",
        "deployment/**",
        "deploy/**",
        "infra/**",
        "terraform/**",
        "k8s/**",
        "kubernetes/**",
        "Dockerfile",
        "Dockerfile.*",
        "docker-compose*.yml",
        "docker-compose*.yaml",
        "nginx/**",
        "apache/**",
        "scripts/deploy*",
        ".env.example"
      ]
    },
    "gates": {},
    "thresholds": {
      "max_file_bytes": 5242880,
      "max_changed_files": 200,
      "max_additions": 5000,
      "risk_warning": 40,
      "risk_fail": 85
    },
    "branch_naming": {
      "allowed_patterns": [
        "^(feature|feat|fix|hotfix|release|chore|docs|test|refactor|security|codex)/[a-zA-Z0-9._/-]+$",
        "^(main|master|develop|development|staging)$"
      ]
    },
    "commit_messages": {
      "allowed_patterns": [
        "^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|security|release|promote|revert)(\\([^)]+\\))?: .+",
        "^Merge .+"
      ]
    },
    "evidence": {
      "required_fields": [
        "business purpose",
        "testing performed",
        "rollback strategy",
        "linked issue",
        "ADDITIONAL_PR_REQUIRED",
        "REMAINING_PR_COUNT"
      ],
      "screenshots_required_for_ui_changes": true
    },
    "runtime": {
      "install_dependencies": true,
      "allow_network_installs": true,
      "fail_fast_on_secrets": true
    },
    "adapters": {}
  },
  "generated_path_components": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "coverage",
    ".next",
    ".gradle",
    "target",
    "Pods",
    "__pycache__"
  ],
  "generated_artifact_patterns": [
    "*.pyc",
    "*.pyo",
    "*.class",
    "*.o",
    "*.so",
    "*.dll",
    "*.dylib",
    "*.min.js.map",
    "storage/logs/**"
  ],
  "allowed_binary_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".pdf"
  ],
  "allowed_hidden_files": [
    ".github",
    ".gitleaks.toml",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".styleci.yml",
    ".dockerignore",
    ".env.example",
    ".env.sample",
    ".env.template"
  ],
  "stack_integrity_exceptions": {
    "react_native": {
      "hidden_text_files": [
        ".watchmanconfig",
        ".bundle/config",
        "ios/.xcode.env"
      ],
      "binary_bootstrap_files": [
        "android/gradle/wrapper/gradle-wrapper.jar",
        "android/app/debug.keystore"
      ],
      "line_ending_text_files": [
        "android/gradlew.bat"
      ],
      "max_gradle_wrapper_jar_bytes": 262144,
      "max_debug_keystore_bytes": 16384,
      "max_hidden_text_file_bytes": 8192
    }
  },
  "approved_governance_assets": [
    ".gitleaks.toml",
    ".github/**",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".dockerignore",
    ".styleci.yml",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    "policy/**",
    "schemas/**"
  ],
  "repository_profiles": {
    "application": {
      "purpose": "Production and customer-facing application repositories.",
      "approved_governance_assets": [],
      "approved_regression_fixtures": []
    },
    "framework": {
      "purpose": "Internal engineering frameworks that carry policy, schema, test, and release-governance assets.",
      "approved_governance_assets": [
        "docs/**",
        "examples/**",
        "operations/**",
        "releases/**",
        "tests/**"
      ],
      "approved_deployment_sensitive_assets": [
        ".github/workflows/**",
        "workflow-templates/**"
      ],
      "approved_regression_fixtures": [
        ".gitleaks.toml",
        "tests/test_pr_qa_regressions.py"
      ]
    },
    "infrastructure": {
      "purpose": "Terraform, Kubernetes, and deployment-control repositories.",
      "approved_governance_assets": [],
      "approved_regression_fixtures": []
    },
    "library": {
      "purpose": "Shared libraries consumed by application repositories.",
      "approved_governance_assets": [],
      "approved_regression_fixtures": []
    },
    "documentation": {
      "purpose": "Documentation-only repositories.",
      "approved_governance_assets": [],
      "approved_regression_fixtures": []
    }
  },
  "executable_extensions": [
    ".php",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".py",
    ".go",
    ".java",
    ".kt",
    ".kts",
    ".swift",
    ".cs",
    ".rs",
    ".rb",
    ".sh",
    ".bash",
    ".ps1",
    ".sql"
  ],
  "known_technology_markers": [
    "composer.json",
    "package.json",
    "pyproject.toml",
    "requirements.txt",
    "go.mod",
    "build.gradle",
    "build.gradle.kts",
    "pom.xml",
    "Package.swift",
    "Cargo.toml",
    "*.sln",
    "*.csproj"
  ],
  "secret_scan": {
    "require_gitleaks": true,
    "scan_encoded_values": true,
    "minimum_base64_length": 24
  }
}
