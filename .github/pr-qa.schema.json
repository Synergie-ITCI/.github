{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synergie PR QA Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_hygiene": { "type": "boolean" },
        "formatting": { "type": "boolean" },
        "lint": { "type": "boolean" },
        "build": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "git_validation": { "type": "boolean" },
        "secrets": { "type": "boolean" },
        "dependency_security": { "type": "boolean" },
        "licence_compliance": { "type": "boolean" },
        "deployment_risk": { "type": "boolean" },
        "migration_risk": { "type": "boolean" },
        "large_files": { "type": "boolean" },
        "documentation": { "type": "boolean" },
        "protected_resources": { "type": "boolean" },
        "ai_advisory": { "type": "boolean" },
        "risk_engine": { "type": "boolean" },
        "evidence_validation": { "type": "boolean" }
      }
    },
    "large_file_threshold_mb": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "fail_on_dependency_vulnerabilities": {
      "type": "boolean",
      "default": false
    },
    "evidence_enforcement": {
      "type": "string",
      "enum": ["fail", "warn"],
      "default": "fail"
    },
    "repository_criticality": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "max_changed_files_for_low_risk": {
      "type": "integer",
      "minimum": 1,
      "default": 20
    }
  }
}
